# services/identity-kcb 환경변수 (실제 값 커밋 금지)
# ──────────────────────────────────────────────────────────────────────────
PORT=8081

# KCB 회원사코드 12자리
KCB_CP_CD=V44210000000
# 운영계 PROD / 테스트계 TEST (휴대폰 본인확인 테스트계는 미운영 → 보통 PROD)
KCB_TARGET=PROD
# 라이선스 .dat 절대경로 (이미지에 굽지 말고 시크릿/볼륨 마운트)
KCB_LICENSE_PATH=/etc/okcert3/V44210000000_IDS_01_PROD_AES_license.dat
# 인증 팝업 제출 URL (운영계)
KCB_POPUP_URL=https://safe.ok-name.co.kr/CommonSvl
# 요청 사이트명 (최대 24 bytes — LGU 제한)
KCB_SITE_NAME=THE ONE
KCB_SITE_URL=https://theone.kr
# 인증요청사유 00:회원가입 01:성인인증 02:정보수정 03:비번찾기 04:상품구매 99:기타
KCB_RQST_CAUS_CD=00

# 이 서비스의 외부 접근 베이스 URL (RETURN_URL/popup/done 생성용, 끝 슬래시 없이)
SELF_BASE_URL=https://identity.theone.kr

# apps/web ↔ 이 서비스 간 Bearer 공유 시크릿(랜덤 32+자). apps/web 의 KCB_SHARED_SECRET 와 동일값.
SHARED_SECRET=

# 팝업 토큰/결과 보관 TTL(초). KCB 서버 시간 허용오차(±10분)와 동일하게 600 권장.
KCB_SESSION_TTL=600

# 임시 공개 테스트 트리거(GET /kcb/test) — KCB 점검용. Bearer 없이 브라우저로 본인확인 플로우 확인.
# 실제 KCB 거래가 발생하므로 평시 false, 점검 시에만 true 로 켰다가 끈다.
KCB_TEST_PAGE_ENABLED=false
