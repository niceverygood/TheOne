# OS
.DS_Store

# Editor / harness
.claude/
.idea/
.vscode/*
!.vscode/extensions.json

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# Expo / React Native
apps/mobile/.expo/
apps/mobile/web-build/
apps/mobile/pc-api-key.json
apps/mobile/AuthKey_*.p8
# 네이티브 디렉터리는 prebuild 산출물 — 커밋하지 않는다(android 과 동일).
# (옛 SDK51 시절 커밋된 ios/Podfile.lock 이 SDK52 podspec 과 충돌 → EAS iOS 빌드 실패.
#  EAS 가 매 빌드 fresh prebuild 하도록 ios/ 도 무시. 로컬 ios/ 는 expo prebuild 로 재생성)
apps/mobile/ios/
apps/mobile/android/
*.orig.*
# EAS 빌드 산출물 (다운로드 아카이브 — 커밋/업로드 금지)
*.aab
*.ipa
*.apk
# eas 가 루트에 잘못 생성하는 projectId stub (진짜 설정은 apps/mobile/app.json)
/app.json

# Env / secrets
.env
.env.*
!.env.example
# Firebase Admin SDK 서비스 계정 키 (절대 커밋 금지)
*firebase-adminsdk*.json
# 세션 산출물/아카이브 (커밋 금지)
apps/mobile/assets.zip
apps/mobile/build-*.tar.gz

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test / coverage
coverage/

# Prisma
packages/db/prisma/*.db
packages/db/prisma/migrations/dev.db*

# Sentry
.sentryclirc

# Next.js generated
next-env.d.ts
.vercel
