# OS
.DS_Store

# Editor / harness
.claude/
.idea/
.vscode/*
!.vscode/extensions.json

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
.next/
out/
.turbo/
*.tsbuildinfo

# Expo / React Native
apps/mobile/.expo/
apps/mobile/web-build/
apps/mobile/pc-api-key.json
apps/mobile/AuthKey_*.p8
# Xcode 빌드 산출물 (ios/ 자체는 prebuild 산출물이라 커밋)
apps/mobile/ios/build/
apps/mobile/ios/Pods/
apps/mobile/ios/**/xcuserdata/
apps/mobile/ios/**/*.xcuserstate
*.orig.*
# EAS 빌드 산출물 (다운로드 아카이브 — 커밋/업로드 금지)
*.aab
*.ipa
*.apk
# eas 가 루트에 잘못 생성하는 projectId stub (진짜 설정은 apps/mobile/app.json)
/app.json

# Env / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test / coverage
coverage/

# Prisma
packages/db/prisma/*.db
packages/db/prisma/migrations/dev.db*

# Sentry
.sentryclirc

# Next.js generated
next-env.d.ts
