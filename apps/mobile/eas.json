{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "COREPACK_INTEGRITY_KEYS": "0",
        "EXPO_UNSTABLE_CORE_AUTOLINKING": "1"
      },
      "ios": {
        "simulator": true,
        "resourceClass": "m-medium",
        "image": "latest"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "COREPACK_INTEGRITY_KEYS": "0",
        "EXPO_UNSTABLE_CORE_AUTOLINKING": "1"
      },
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium",
        "image": "latest"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "COREPACK_INTEGRITY_KEYS": "0",
        "EXPO_UNSTABLE_CORE_AUTOLINKING": "1"
      },
      "ios": {
        "resourceClass": "m-medium",
        "image": "latest"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "bottletasteinc@gmail.com",
        "appleTeamId": "7AXRWTV5YW"
      },
      "android": {
        "serviceAccountKeyPath": "./pc-api-key.json",
        "track": "internal"
      }
    }
  }
}
