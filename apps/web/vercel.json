{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "cd ../.. && pnpm --filter @theone/web build",
  "installCommand": "cd ../.. && pnpm install",
  "regions": ["icn1"],
  "crons": [
    {
      "path": "/api/cron/curation",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/curation",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/curation",
      "schedule": "0 11 * * *"
    }
  ]
}
