// THE ONE · Prisma 스키마
// Phase 3: docs/verification-sop.md / privacy-design.md 를 코드로 옮긴 도메인 모델.
// Match/Conversation/Message/Credit 등 매칭·경제 모델은 스키마만 정의(로직은 Phase 5).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// Enums
// ============================================================

enum Gender {
  male
  female
}

enum UserStatus {
  pending // 가입 심사 대기
  active // 활동
  suspended // 정지
  withdrawn // 탈퇴
}

enum VerificationType {
  education // 학력
  wealth // 재산
  vehicle // 차량
  realestate // 부동산
  income // 소득
  job // 직업
  family_wealth // 집안 자산
  reputation // 명성
}

enum VerificationStatus {
  submitted // 제출됨(검토 시작 전)
  reviewing // 검토 중
  approved // 승인
  rejected // 반려(재제출 가능)
}

/// 운영자 권한 3단계 (verification-sop §5-1)
enum OperatorRole {
  viewer // 메타만
  reviewer // 문서 열람·승인·반려
  admin // 정책·계정·강제파기
}

/// AccessLog 액션 (privacy-design §2-4)
enum AccessAction {
  view_meta
  view_document
  approve
  reject
  export
  purge
}

enum MatchStatus {
  pending
  accepted
  declined
  ended
}

enum CreditReason {
  charge // 충전
  letter // 만남 신청서
  super_letter // 슈퍼 신청서
  refund // 환불
  bonus // 보너스
  verify_reward // 추가 인증 승인 보상
  referral_reward // 회원 추천 보상
  referral_clawback // 추천 보상 회수
}

/// 회원 추천 보상 이벤트 (MVP)
enum ReferralRewardType {
  signup_approved // 피추천인 가입 심사 통과
  first_purchase // 피추천인 첫 결제
}

enum ReferralRewardStatus {
  granted // 지급됨
  clawed_back // 회수됨(탈퇴·정지·환불)
}

/// 본인 명의 아님 — 수동 본인인증 요청 상태
enum ManualIdReviewStatus {
  pending // 접수
  approved // 본인 확인 완료
  rejected // 반려
}

enum ReportCategory {
  fraud // 사기·금전요구
  harassment // 성희롱·외설
  external_contact // 외부 연락 유도
  inappropriate_photo // 부적절한 사진
  abuse // 비속어·모욕
  impersonation // 사칭·가짜 프로필
  no_show // 노쇼·약속위반
  other
}

/// 퍼널 이벤트 단계 (Phase 1: 광고→LP→폼→가입). Postgres enum은 추후 앱 단계 추가 가능.
enum FunnelEventType {
  page_view // 페이지/LP 조회
  waitlist_view // 사전등록 폼 노출(뷰포트 진입)
  waitlist_start // 폼 상호작용 시작(첫 입력/포커스)
  waitlist_submit // 제출 시도(검증·봇 통과 후)
  waitlist_success // 가입 완료(전환)
  waitlist_duplicate // 중복 이메일
  waitlist_error // 검증/서버 실패
}

// ============================================================
// Waitlist (Phase 1)
// ============================================================

/// Phase 1 — 사전등록(웨이팅리스트).
model Waitlist {
  id           String    @id @default(cuid())
  seq          Int       @unique @default(autoincrement())
  email        String    @unique
  gender       Gender
  jobCategory  String    @map("job_category")
  referralCode String?   @map("referral_code")
  utmSource    String?   @map("utm_source")
  utmMedium    String?   @map("utm_medium")
  utmCampaign  String?   @map("utm_campaign")
  utmTerm      String?   @map("utm_term")
  utmContent   String?   @map("utm_content")
  fbclid       String?
  visitorId    String?   @map("visitor_id") // 퍼널 이벤트와 연결되는 익명 방문자 id
  userAgent    String?   @map("user_agent")
  ipHash       String?   @map("ip_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  confirmedAt  DateTime? @map("confirmed_at")

  @@index([createdAt])
  @@index([jobCategory])
  @@index([visitorId])
  @@map("waitlist")
}

// ============================================================
// Analytics / Funnel (Phase 1) — 광고 유입→가입 전환 분석
// ============================================================

/// 퍼널 이벤트 스트림(append-only). 익명 방문자 단위로 광고 어트리뷰션(utm/fbclid)과 함께 단계를 기록.
/// 원본 IP는 저장하지 않고 솔트 해시(ipHash)만 보관. 개인 식별정보 없음(이메일 등은 Waitlist에만).
model AnalyticsEvent {
  id          String          @id @default(cuid())
  type        FunnelEventType
  visitorId   String          @map("visitor_id") // 익명 방문자 쿠키 id (theone_vid)
  path        String? // 이벤트 발생 경로
  referrer    String? // 최초 유입 referrer
  landing     String? // 최초 랜딩 경로
  utmSource   String?         @map("utm_source")
  utmMedium   String?         @map("utm_medium")
  utmCampaign String?         @map("utm_campaign")
  utmTerm     String?         @map("utm_term")
  utmContent  String?         @map("utm_content")
  fbclid      String? // Facebook 광고 클릭 id
  fbc         String? // _fbc 쿠키(또는 fbclid 파생) — CAPI 매칭용
  fbp         String? // _fbp 쿠키 — CAPI 매칭용
  userAgent   String?         @map("user_agent")
  ipHash      String?         @map("ip_hash")
  country     String?
  meta        Json?
  createdAt   DateTime        @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([type, createdAt])
  @@index([visitorId])
  @@index([utmCampaign])
  @@index([utmSource])
  @@map("analytics_event")
}

// ============================================================
// User / Profile
// ============================================================

model User {
  id          String     @id @default(cuid())
  seq         Int        @unique @default(autoincrement()) // 추천 코드 파생용 순번
  phone       String?    @unique // 본인인증 후 (암호화 대상)
  email       String?    @unique
  gender      Gender
  birth       DateTime?
  jobCategory String     @map("job_category")
  status      UserStatus @default(pending)
  /// 본인인증 고유식별 (암호화 컬럼 — privacy-design §2-4)
  ciHash      String?    @unique @map("ci_hash")
  /// 추천인(가입 시 추천코드로 연결). 자기참조.
  referredById String?   @map("referred_by_id")
  referredBy   User?     @relation("referral", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    User[]    @relation("referral")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  withdrawnAt DateTime?  @map("withdrawn_at")

  profile      Profile?
  applications VerificationApplication[]
  badges       VerificationBadge[]
  credit       Credit?
  creditTxns   CreditTransaction[]
  sentMatches  Match[]                   @relation("matchFrom")
  recvMatches  Match[]                   @relation("matchTo")
  messages     Message[]
  reportsMade  ReportLog[]               @relation("reporter")
  reportsRecv  ReportLog[]               @relation("reported")
  blocksMade   BlockList[]               @relation("blocker")
  blocksRecv   BlockList[]               @relation("blocked")
  curationsFor CurationLog[]             @relation("curationViewer")
  curationsAs  CurationLog[]             @relation("curationCandidate")
  orders       Order[]
  rewardsAsReferrer ReferralReward[]     @relation("rewardReferrer")
  rewardsAsReferee  ReferralReward[]     @relation("rewardReferee")
  /// 누적 정지 횟수 (신고 3회 자동 일시정지 — trust-safety §3-2)
  suspendCount Int                       @default(0) @map("suspend_count")

  @@index([status])
  @@index([referredById])
  @@map("users")
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos    String[] // S3 key 목록
  bio       String?  @db.Text
  jobDetail String?  @map("job_detail")
  region    String?
  mbti      String?
  // ── 가입 설문(Phase 4) ─────────────────────────────
  height           Int?     @map("height") // cm
  residenceRegion  String?  @map("residence_region") // 사는지역
  activityRegion   String?  @map("activity_region") // 활동지역
  school           String?
  hobbies          String[] // 취미(다중)
  drinkingFrequency String? @map("drinking_frequency")
  drinkingAmount   String?  @map("drinking_amount")
  smoking          String?
  bodyType         String?  @map("body_type")
  /// 가치관 설문 60문항 응답(Likert 1~5) — 매칭 케미 분석 입력. 미응답 시 빈 배열.
  surveyAnswers    Int[]    @default([]) @map("survey_answers")
  /// AI 생성 + 사용자 편집한 자기소개 섹션(about/idealType/...)
  introSections    Json?    @map("intro_sections")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("profiles")
}

// ============================================================
// 인증 (verification-sop)
// ============================================================

model Operator {
  id           String       @id @default(cuid())
  username     String       @unique
  name         String
  role         OperatorRole @default(viewer)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now()) @map("created_at")
  reviewedApps VerificationApplication[] @relation("reviewer")
  accessLogs   AccessLog[]
  manualIdReviews ManualIdentityRequest[] @relation("manualIdReviewer")

  @@map("operators")
}

/// 본인 명의 아님 — 운영자 수동 본인인증 요청 큐 (privacy-design: 고유식별정보=신분증).
/// 신분증 사진은 S3 키만 보관(KMS 암호화). 검토 완료 후 30일 자동 파기(purgeAt).
model ManualIdentityRequest {
  id          String               @id @default(cuid())
  name        String
  phone       String
  /// 신분증 사진 S3 객체 키 (평문 URL 보관 금지)
  idCardS3Key String               @map("id_card_s3_key")
  note        String?              @db.Text
  status      ManualIdReviewStatus @default(pending)
  reviewerId  String?              @map("reviewer_id")
  reviewer    Operator?            @relation("manualIdReviewer", fields: [reviewerId], references: [id])
  rejectReason String?             @map("reject_reason")
  createdAt   DateTime             @default(now()) @map("created_at")
  reviewedAt  DateTime?            @map("reviewed_at")
  /// 검토 완료 후 30일 자동 파기 시각
  purgeAt     DateTime?            @map("purge_at")

  @@index([status, createdAt])
  @@map("manual_identity_requests")
}

model VerificationApplication {
  id           String             @id @default(cuid())
  userId       String             @map("user_id")
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         VerificationType
  status       VerificationStatus @default(submitted)
  /// 재산/부동산 가액 구간 (예: "10억~30억")
  valueTier    String?            @map("value_tier")
  reviewerId   String?            @map("reviewer_id")
  reviewer     Operator?          @relation("reviewer", fields: [reviewerId], references: [id])
  rejectReason String?            @map("reject_reason")
  submittedAt  DateTime           @default(now()) @map("submitted_at")
  reviewedAt   DateTime?          @map("reviewed_at")
  /// SLA 마감 (제출 + 24h)
  slaDueAt     DateTime           @map("sla_due_at")

  documents VerificationDocument[]

  @@index([status, slaDueAt])
  @@index([userId])
  @@map("verification_applications")
}

model VerificationDocument {
  id            String                  @id @default(cuid())
  applicationId String                  @map("application_id")
  application   VerificationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// S3 객체 키 (KMS 암호화 저장). 평문 URL 보관 금지.
  s3Key         String                  @map("s3_key")
  label         String // 서류명 (예: "졸업증명서")
  mime          String
  size          Int
  sha256        String
  uploadedAt    DateTime                @default(now()) @map("uploaded_at")
  /// 검토 완료 후 30일 자동 파기 시각 기록
  purgedAt      DateTime?               @map("purged_at")

  @@index([applicationId])
  @@map("verification_documents")
}

model VerificationBadge {
  id         String           @id @default(cuid())
  userId     String           @map("user_id")
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       VerificationType
  valueTier  String?          @map("value_tier")
  verifiedAt DateTime         @default(now()) @map("verified_at")
  /// 유효기간 1년 (verification-sop §5-3)
  expiresAt  DateTime         @map("expires_at")

  @@unique([userId, type])
  @@index([expiresAt])
  @@map("verification_badges")
}

/// 모든 서류 열람·처리 기록 (privacy-design §2-4, 1년 보관)
model AccessLog {
  id           String       @id @default(cuid())
  operatorId   String       @map("operator_id")
  operator     Operator     @relation(fields: [operatorId], references: [id])
  targetUserId String?      @map("target_user_id")
  documentId   String?      @map("document_id")
  applicationId String?     @map("application_id")
  action       AccessAction
  ip           String?
  at           DateTime     @default(now())

  @@index([at])
  @@index([operatorId])
  @@map("access_logs")
}

// ============================================================
// 매칭 / 경제 (스키마만 — 로직은 Phase 5)
// ============================================================

model Match {
  id        String      @id @default(cuid())
  fromId    String      @map("from_id")
  toId      String      @map("to_id")
  from      User        @relation("matchFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to        User        @relation("matchTo", fields: [toId], references: [id], onDelete: Cascade)
  status    MatchStatus @default(pending)
  /// 만남 신청서 본문
  letter    String?     @db.Text
  isSuper   Boolean     @default(false) @map("is_super")
  createdAt DateTime    @default(now()) @map("created_at")
  endedAt   DateTime?   @map("ended_at")

  conversation Conversation?

  @@index([toId, status])
  @@map("matches")
}

model Conversation {
  id        String    @id @default(cuid())
  matchId   String    @unique @map("match_id")
  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")
  /// 매칭·대화 보관: 종료 후 6개월 (privacy-design §2-3)
  purgeAt   DateTime? @map("purge_at")
  messages  Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String       @map("sender_id")
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String       @db.Text
  /// 외부 연락처 마스킹 적용 여부 (trust-safety §3-3)
  masked         Boolean      @default(false)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Credit {
  id        String   @id @default(cuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("credits")
}

model CreditTransaction {
  id        String       @id @default(cuid())
  userId    String       @map("user_id")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int // +충전 / -사용
  reason    CreditReason
  refId     String?      @map("ref_id") // 결제·매칭 참조
  createdAt DateTime     @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("credit_transactions")
}

/// 회원 추천 보상 원장 — 추천인이 받은 보상 1건. 피추천인×타입 1회(멱등).
model ReferralReward {
  id         String               @id @default(cuid())
  referrerId String               @map("referrer_id")
  refereeId  String               @map("referee_id")
  referrer   User                 @relation("rewardReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee    User                 @relation("rewardReferee", fields: [refereeId], references: [id], onDelete: Cascade)
  type       ReferralRewardType
  credits    Int
  status     ReferralRewardStatus @default(granted)
  /// 결제 보상의 경우 참조 주문
  refId      String?              @map("ref_id")
  createdAt  DateTime             @default(now()) @map("created_at")
  clawedBackAt DateTime?          @map("clawed_back_at")

  @@unique([refereeId, type])
  @@index([referrerId])
  @@map("referral_rewards")
}

// ============================================================
// 신고 / 차단 (trust-safety)
// ============================================================

model ReportLog {
  id         String         @id @default(cuid())
  reporterId String         @map("reporter_id")
  reportedId String         @map("reported_id")
  reporter   User           @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported   User           @relation("reported", fields: [reportedId], references: [id], onDelete: Cascade)
  category   ReportCategory
  detail     String?        @db.Text
  handledAt  DateTime?      @map("handled_at")
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([reportedId])
  @@map("report_logs")
}

model BlockList {
  id        String   @id @default(cuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  blocker   User     @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([blockerId, blockedId])
  @@map("block_lists")
}

// ============================================================
// 매칭 큐레이션 로그 / 결제 (Phase 5)
// ============================================================

enum CurationAction {
  sent // 발송됨(노출)
  viewed
  passed
  liked
  superliked
}

/// 매일 1명 큐레이션 발송·반응 로그 (ML 학습 데이터 축적)
model CurationLog {
  id          String         @id @default(cuid())
  userId      String         @map("user_id")
  candidateId String         @map("candidate_id")
  user        User           @relation("curationViewer", fields: [userId], references: [id], onDelete: Cascade)
  candidate   User           @relation("curationCandidate", fields: [candidateId], references: [id], onDelete: Cascade)
  action      CurationAction @default(sent)
  /// 매칭 점수(룰베이스) 스냅샷
  score       Int?
  /// 가치관 케미 일치도(0~100) 스냅샷 — 도시에 "케미 일치도" 표기용. 설문 미완료 시 null.
  chemistry   Int?
  sentAt      DateTime       @default(now()) @map("sent_at")
  viewedAt    DateTime?      @map("viewed_at")

  @@unique([userId, candidateId, sentAt])
  @@index([userId, sentAt])
  @@map("curation_logs")
}

enum PaymentStatus {
  pending
  paid
  failed
  cancelled
  refunded
  partial_refunded
}

/// 크레딧 충전 주문 (PortOne v2)
model Order {
  id            String        @id @default(cuid())
  userId        String        @map("user_id")
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId     String        @map("package_id")
  amountWon     Int           @map("amount_won")
  credits       Int // 보너스 포함 지급 크레딧
  baseCredits   Int           @map("base_credits") // 환불 단가 계산용(보너스 제외)
  status        PaymentStatus @default(pending)
  /// 결제 식별자 — IAP transactionId(Apple/Google) 또는 PortOne paymentId
  paymentId     String?       @map("payment_id")
  /// 결제 제공자 — 'iap_apple' | 'iap_google' (v1.0) | 'portone' (v1.1)
  provider      String        @default("iap_apple")
  refundedWon   Int           @default(0) @map("refunded_won")
  createdAt     DateTime      @default(now()) @map("created_at")
  paidAt        DateTime?     @map("paid_at")

  @@index([userId, createdAt])
  @@index([status])
  @@map("orders")
}
