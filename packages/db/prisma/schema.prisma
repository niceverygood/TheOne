// THE ONE · Prisma 스키마
// Phase 0: 골격 + 웨이팅리스트만. 도메인 전체 모델(User/Verification*/Match/Credit 등)은
// Phase 3에서 docs/verification-sop.md 를 코드로 옮기며 확장한다.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Gender {
  male
  female
}

/// Phase 1 — 사전등록(웨이팅리스트).
/// 운영상 Supabase Postgres를 사용. 동일 스키마를 여기에 미러링해 Phase 3 이관을 대비.
model Waitlist {
  id           String    @id @default(cuid())
  /// 등록 순번 (성공 화면 "#142번째" + 공유 초대코드 베이스)
  seq          Int       @unique @default(autoincrement())
  email        String    @unique
  gender       Gender
  jobCategory  String    @map("job_category")
  referralCode String?   @map("referral_code")
  utmSource    String?   @map("utm_source")
  utmMedium    String?   @map("utm_medium")
  utmCampaign  String?   @map("utm_campaign")
  utmTerm      String?   @map("utm_term")
  utmContent   String?   @map("utm_content")
  /// 분석용 메타 — CSV export 시 제외
  userAgent    String?   @map("user_agent")
  ipHash       String?   @map("ip_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  /// 확인 메일 클릭 시각 (오픈/확인율 추적)
  confirmedAt  DateTime? @map("confirmed_at")

  @@index([createdAt])
  @@index([jobCategory])
  @@map("waitlist")
}
