# ============================================================
# THE ONE (더원) · 환경변수 템플릿
# 복사: cp .env.example .env  (실제 값은 절대 커밋 금지)
# ============================================================

# --- Database (packages/db) ---
DATABASE_URL="postgresql://theone:theone@localhost:5432/theone?schema=public"
DIRECT_URL="postgresql://theone:theone@localhost:5432/theone?schema=public"

# --- Web (apps/web) — 랜딩 + 웨이팅리스트 ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Phase 1: Supabase Postgres
#   DATABASE_URL: 앱 런타임용 (Pooler, port 6543, ?pgbouncer=true)
#   DIRECT_URL  : 마이그레이션용 (Direct, port 5432)
# 위 [Database] 섹션의 DATABASE_URL/DIRECT_URL을 Supabase 값으로 교체.

# Phase 1: Resend (등록 확인 메일) — 발신 도메인은 DNS TXT 인증 후 ~30분
RESEND_API_KEY=""
RESEND_FROM="THE ONE <noreply@the-one.kr>"

# Phase 1: Cloudflare Turnstile (봇 차단) — 사이트키/시크릿키 2개
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# 사전등록 IP 해시 솔트 (평문 IP 저장 안 함)
IP_HASH_SALT="change-me-in-production"

# --- Admin (apps/admin) — 인증 심사 콘솔 ---
ADMIN_BASIC_AUTH_USER="admin"
ADMIN_BASIC_AUTH_PASSWORD=""

# --- 인증 서류 저장 (Phase 3) ---
# S3 + KMS 암호화, 검토 완료 30일 후 자동 파기
AWS_REGION="ap-northeast-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_VERIFICATION_DOCS=""
KMS_KEY_ID=""

# --- 보비(BOBI) 재사용 인프라 ---
# CODEF 자산조회 (재산 인증 트랙 B)
CODEF_CLIENT_ID=""
CODEF_CLIENT_SECRET=""
CODEF_PUBLIC_KEY=""

# 인앱결제(IAP) — 크레딧 충전. 영수증 서버 검증용.
# Apple: App Store Connect → 앱 → '앱 전용 공유 비밀'(verifyReceipt 용). 미설정 시 mock(영수증 무검증) → 운영 필수.
APPLE_IAP_SHARED_SECRET=""
# Google Play: 서비스계정 JSON 전체를 한 줄로(또는 \n 이스케이프). androidpublisher 권한 + Play Console 연결 필요.
# 미설정 시 mock(영수증 무검증) → 운영 필수.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=""
GOOGLE_PLAY_PACKAGE_NAME="kr.theone.app"

# PortOne v2 결제 (Phase 5)
PORTONE_API_SECRET=""
PORTONE_STORE_ID=""
PORTONE_WEBHOOK_SECRET=""
# 카카오페이 정기결제 CID
KAKAOPAY_CID="CT97630018"

# 카카오 알림톡 (인증 결과 통지)
KAKAO_ALIMTALK_API_KEY=""
KAKAO_ALIMTALK_SENDER_KEY=""

# --- 본인인증 (PortOne v2 통합 본인인증) ---
# 결제와 동일한 PortOne 스토어 사용. 콘솔에서 "본인인증 채널" 추가 후 채널키 입력.
# 서버 검증(/api/identity/verify)은 위 PORTONE_API_SECRET 을 재사용한다.
PORTONE_IDENTITY_CHANNEL_KEY=""            # 본인인증 채널 키 (PortOne 콘솔 → 채널 관리)
IDENTITY_CI_PEPPER=""                      # CI 해시용 서버 시크릿(임의 난수 — 절대 노출/커밋 금지)
# 모바일(Expo) 클라이언트 노출용 — secret 아님(공개돼도 안전한 값만)
EXPO_PUBLIC_IDENTITY_PROVIDER="mock"       # mock | portone
EXPO_PUBLIC_PORTONE_STORE_ID=""            # store-xxxxxxxx
EXPO_PUBLIC_PORTONE_IDENTITY_CHANNEL_KEY=""
EXPO_PUBLIC_API_BASE_URL=""                # apps/web 배포 주소 (서버 재검증 /api/identity/* 호출용)

# --- 본인인증 (KCB OkCert3 휴대폰 본인확인 — 선택된 방식) ---
# KCB 모듈은 상주 Java 서비스(services/identity-kcb)에서만 동작(Vercel 불가).
# apps/web 는 아래 두 값으로 그 서비스를 서버-투-서버(Bearer)로 호출한다.
# 미설정 시 /api/identity/kcb/* 는 mock(성인 통과)으로 동작 — 데모/심사용.
# IDENTITY_CI_PEPPER(위)는 KCB CI 해시에도 동일하게 재사용한다.
KCB_SERVICE_URL=""                         # identity-kcb 배포 주소 (예: https://identity.theone.kr)
KCB_SHARED_SECRET=""                       # identity-kcb 의 SHARED_SECRET 와 동일값(랜덤 32+자)
# (Java 서비스 자체 환경변수는 services/identity-kcb/.env.example 참고:
#  KCB_CP_CD / KCB_TARGET / KCB_LICENSE_PATH / SELF_BASE_URL / SHARED_SECRET 등)

# --- AI 자기소개 생성 (가입 마지막 단계) ---
# apps/web /api/profile/generate 가 사용. 미설정 시 규칙기반 템플릿으로 폴백(데모/개발).
# ⚠️ 설정 시 프로필 데이터가 Anthropic(미국)으로 전송됨 → 개인정보처리방침 국외이전 고지 필요.
ANTHROPIC_API_KEY=""                       # Anthropic API 키 (없으면 템플릿 폴백)
PROFILE_AI_MODEL=""                        # 선택: 모델 override (기본 claude-haiku-4-5-20251001)

# --- AI 스튜디오 (사진 1장 → 스타일 4종, gpt-image-2) ---
# apps/web /api/ai/photo-studio 가 사용. 미설정 시 503 not_configured(앱은 "준비 중" 안내).
# ⚠️ 설정 시 사진이 OpenAI(미국)로 전송됨 → 개인정보처리방침 국외이전 고지 필요.
# 원본·결과 모두 서버에 저장하지 않음(즉시 반환).
OPENAI_API_KEY=""
OPENAI_IMAGE_MODEL=""                      # 선택: 기본 gpt-image-2
OPENAI_IMAGE_QUALITY=""                    # 선택: low|medium|high (기본 medium, 비용 조절)

# --- 관측 / 분석 ---
# Sentry (에러)
NEXT_PUBLIC_SENTRY_DSN=""
EXPO_PUBLIC_SENTRY_DSN=""
EXPO_PUBLIC_ENV="development"
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# PostHog (분석)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# GA4 + Microsoft Clarity (Phase 1 LP 계측)
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_CLARITY_ID=""

# --- Facebook 광고 퍼널 (Pixel + Conversions API) ---
# 미설정 시 Pixel/CAPI 모두 no-op. 내부 퍼널(어드민 /funnel)은 키 없이도 동작.
# NEXT_PUBLIC_FB_PIXEL_ID: 브라우저 Pixel(클라이언트) — 공개값
NEXT_PUBLIC_FB_PIXEL_ID=""
# 서버 Conversions API — 픽셀 ID(동일값)와 액세스 토큰. ⚠️ 해시 이메일 전송 → 개인정보처리방침 반영 필요
FB_PIXEL_ID=""
FB_CAPI_ACCESS_TOKEN=""
FB_GRAPH_VERSION="v19.0"
# 테스트 이벤트 검증 시에만(이벤트 관리자 → 테스트 이벤트 코드). 운영 배포 시 비움
FB_CAPI_TEST_EVENT_CODE=""

# Slack 알림
SLACK_WEBHOOK_URL=""
