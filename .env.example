# ============================================================
# THE ONE (더원) · 환경변수 템플릿
# 복사: cp .env.example .env  (실제 값은 절대 커밋 금지)
# ============================================================

# --- Database (packages/db) ---
DATABASE_URL="postgresql://theone:theone@localhost:5432/theone?schema=public"
DIRECT_URL="postgresql://theone:theone@localhost:5432/theone?schema=public"

# --- Web (apps/web) — 랜딩 + 웨이팅리스트 ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Phase 1: Supabase Postgres
#   DATABASE_URL: 앱 런타임용 (Pooler, port 6543, ?pgbouncer=true)
#   DIRECT_URL  : 마이그레이션용 (Direct, port 5432)
# 위 [Database] 섹션의 DATABASE_URL/DIRECT_URL을 Supabase 값으로 교체.

# Phase 1: Resend (등록 확인 메일) — 발신 도메인은 DNS TXT 인증 후 ~30분
RESEND_API_KEY=""
RESEND_FROM="THE ONE <noreply@the-one.kr>"

# Phase 1: Cloudflare Turnstile (봇 차단) — 사이트키/시크릿키 2개
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# 사전등록 IP 해시 솔트 (평문 IP 저장 안 함)
IP_HASH_SALT="change-me-in-production"

# --- Admin (apps/admin) — 인증 심사 콘솔 ---
ADMIN_BASIC_AUTH_USER="admin"
ADMIN_BASIC_AUTH_PASSWORD=""

# --- 인증 서류 저장 (Phase 3) ---
# S3 + KMS 암호화, 검토 완료 30일 후 자동 파기
AWS_REGION="ap-northeast-2"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET_VERIFICATION_DOCS=""
KMS_KEY_ID=""

# --- 보비(BOBI) 재사용 인프라 ---
# CODEF 자산조회 (재산 인증 트랙 B)
CODEF_CLIENT_ID=""
CODEF_CLIENT_SECRET=""
CODEF_PUBLIC_KEY=""

# PortOne v2 결제 (Phase 5)
PORTONE_API_SECRET=""
PORTONE_STORE_ID=""
PORTONE_WEBHOOK_SECRET=""
# 카카오페이 정기결제 CID
KAKAOPAY_CID="CT97630018"

# 카카오 알림톡 (인증 결과 통지)
KAKAO_ALIMTALK_API_KEY=""
KAKAO_ALIMTALK_SENDER_KEY=""

# --- 본인인증 (Phase 4) ---
# PASS 또는 KCB(나이스) — 정식 계약 전 mock
PASS_PROVIDER="mock" # mock | pass | kcb
PASS_CLIENT_ID=""
PASS_CLIENT_SECRET=""

# --- 관측 / 분석 ---
# Sentry (에러)
NEXT_PUBLIC_SENTRY_DSN=""
EXPO_PUBLIC_SENTRY_DSN=""
EXPO_PUBLIC_ENV="development"
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# PostHog (분석)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# GA4 + Microsoft Clarity (Phase 1 LP 계측)
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_CLARITY_ID=""

# Slack 알림
SLACK_WEBHOOK_URL=""
